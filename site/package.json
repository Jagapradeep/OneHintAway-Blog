{
  "name": "site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "npm run check-posts && npm run check-viz",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "check-posts": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-posts.mjs",
    "check-viz": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --disable-warning=ExperimentalWarning --experimental-strip-types scripts/check-visualizer.mjs",
    "viz-fixtures": "python ../post-kit/tools/viz_fixtures.py",
    "add-post": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/add-post.mjs"
  },
  "dependencies": {
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "^16.4.3",
    "@shikijs/rehype": "^4.5.0",
    "gray-matter": "^4.0.3",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.5.0"
  },
  "devDependencies": {
    "@types/mdx": "^2.0.14",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "typescript": "^5",
    "wrangler": "^4.156.0"
  }
}
