      "type": "template",
      "teaser": "Bubble sort in 11 lines",
      "title": "Bubble sort",
      "code": {
        "lines": [
          "function bubbleSort(nums):",
          "    n = length(nums)",
          "    for sweep from 1 to n - 1:",
          "        swapped = false",
          "        for j from 0 to n - 1 - sweep:",
          "            if nums[j] > nums[j + 1]:",
          "                swap nums[j], nums[j + 1]",
          "                swapped = true",
          "        if not swapped:",
          "            return nums   // already sorted",
          "    return nums"
        ],
        "highlight": [
          6
        ]
      },
      "example": {
        "call": "bubbleSort([5, 2, 4, 1, 3])",
        "expr": "bubble_sort([5, 2, 4, 1, 3])"
      }
    },
