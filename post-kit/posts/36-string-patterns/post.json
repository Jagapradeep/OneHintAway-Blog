    {
      "type": "template",
      "teaser": "The anagram check in 12 lines",
      "title": "Anagram check",
      "code": {
        "start": 10,
        "lines": [
          "function isAnagram(s, t):",
          "    counts = array of 26 zeros",
          "    for each letter in s:",
          "        k = alphabet index of letter",
          "        counts[k] = counts[k] + 1",
          "    for each letter in t:",
          "        k = alphabet index of letter",
          "        counts[k] = counts[k] - 1",
          "    for each count in counts:",
          "        if count != 0:",
          "            return false",
          "    return true"
        ],
        "highlight": [
          19
        ]
      },
      "explain": "Lines 12 to 17 count s up and t down. Line 19 catches any letter that doesn't match.",
