          "type": "code",
          "lines": [
            "function mergeSort(nums):",
            "    if length(nums) <= 1:",
            "        return nums",
            "    middle = floor(length(nums) / 2)",
            "    left = mergeSort(nums before middle)",
            "    right = mergeSort(the rest of nums)",
            "    return merge(left, right)"
          ]
        }
      ]
    },
    {
      "type": "template",
      "teaser": "The merge in 12 lines",
      "title": "Merge",
      "code": {
        "lines": [
          "function merge(left, right):",
          "    result = empty list",
          "    i = 0",
          "    j = 0",
          "    while neither list has run out:",
          "        if left[i] <= right[j]:",
          "            append left[i] to result",
          "            i = i + 1",
          "        else:",
          "            append right[j] to result",
          "            j = j + 1",
          "    return result + rest of left and right"
        ],
        "highlight": [
          6
        ]
      },
      "explain": "Line 6 compares the two fronts. Line 12 adds what is left: one list is already empty.",
      "example": {
        "call": "merge([2, 4, 5], [1, 3, 6])",
        "expr": "merge([2, 4, 5], [1, 3, 6])"
      }
    },
