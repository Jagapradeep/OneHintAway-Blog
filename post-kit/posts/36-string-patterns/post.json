          "type": "code",
          "lines": [
            "function isPalindrome(word):",
            "    left = 0",
            "    right = length(word) - 1",
            "    while left < right:",
            "        if word[left] != word[right]:",
            "            return false",
            "        left = left + 1",
            "        right = right - 1",
            "    return true"
          ],
          "highlight": [
            5
          ]
        }
      ]
