   "type": "template",
   "teaser": "Merge intervals in 12 lines",
   "title": "Merge intervals",
   "code": {
    "lines": [
     "function merge(intervals):",
     "    sort intervals by start",
     "    merged = empty array",
     "    add intervals[0] to merged",
     "    for i from 1 to length(intervals) - 1:",
     "        [start, end] = intervals[i]",
     "        last = merged[length(merged) - 1]",
     "        if start <= last[1]:",
     "            last[1] = max(last[1], end)",
     "        else:",
     "            add [start, end] to merged",
     "    return merged"
    ],
    "highlight": [
     9
    ]
   },
   "explain": "Line 8 checks for overlap with the last block. Line 9 stretches it, but never shrinks it."
  },
  {
   "type": "trap",
   "teaser": "The bug that splits a block",
   "title": "Keep the max",
   "lead": "A booking inside the block must not shrink it.",
   "trap": {
    "call": "merge([[5, 8], [1, 3], [8, 9], [6, 7], [2, 4]])",
    "wrong": {
     "code": [
      "last[1] = end"
     ],
     "note": "6–7 shrinks 5–8 to 5–7, so 8–9 splits off.",
     "result": "{{fmt(WRONG)}}"
    },
    "right": {
     "code": [
      "last[1] = max(last[1], end)"
     ],
     "note": "5–8 keeps its end; 8–9 joins.",
     "result": "{{fmt(MERGED)}}"
    }
   },
