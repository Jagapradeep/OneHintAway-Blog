          "type": "code",
          "lines": [
            "function rotate(grid):",
            "    n = length(grid)",
            "    for i from 0 to n - 1:",
            "        for j from i + 1 to n - 1:",
            "            swap grid[i][j], grid[j][i]",
            "    for each row in grid:",
            "        reverse row"
          ],
          "highlight": [
            5
          ]
        }
      ]
    },
    {
      "type": "extra",
      "label": "SPIRAL",
      "board": "Spiral, part 1",
      "teaser": "Spiral, part 1: top and right",
      "title": "Top, then right",
      "blocks": [
        {
          "type": "code",
          "start": 8,
          "lines": [
            "function spiralOrder(grid):",
            "    top = 0",
            "    bottom = length(grid) - 1",
            "    left = 0",
            "    right = length(grid[0]) - 1",
            "    result = empty list",
            "    while top <= bottom and left <= right:",
            "        for col from left to right:",
            "            add grid[top][col] to result",
            "        top = top + 1   // wall moves in",
            "        for row from top to bottom:",
            "            add grid[row][right] to result",
            "        right = right - 1   // wall in"
          ],
          "highlight": [
            17
          ]
        }
      ]
    },
    {
      "type": "template",
      "teaser": "Spiral, part 2: bottom and left",
      "title": "Bottom, then left",
      "code": {
        "start": 21,
        "lines": [
          "        if top > bottom or left > right:",
          "            return result   // nothing left",
          "        for col from right down to left:",
          "            add grid[bottom][col] to result",
          "        bottom = bottom - 1",
          "        for row from bottom down to top:",
          "            add grid[row][left] to result",
          "        left = left + 1",
          "    return result"
        ],
        "highlight": [
          21
        ]
      },
