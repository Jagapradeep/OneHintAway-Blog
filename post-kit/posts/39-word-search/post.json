    {
      "type": "extra",
      "label": "THE WALK",
      "board": "The walk",
      "teaser": "The walk: mark, explore, unmark",
      "title": "The walk",
      "blocks": [
        {
          "type": "code",
          "lines": [
            "function walk(grid, word, row, col, i):",
            "    if grid[row][col] != word[i]:",
            "        return false",
            "    if i == length(word) - 1:",
            "        return true   // last letter matched",
            "    grid[row][col] = \"#\"   // in use",
            "    for each [r, c] next to [row, col]:",
            "        if walk(grid, word, r, c, i + 1):",
            "            return true",
            "    grid[row][col] = word[i]   // undo",
            "    return false"
          ],
          "highlight": [
            10
          ]
        },
        {
          "type": "text",
          "style": "muted",
          "text": "i is the letter of word we need on this tile."
        }
      ]
    },
    {
      "type": "template",
      "teaser": "Try every first tile",
      "title": "Try every start",
      "code": {
        "start": 12,
        "lines": [
          "function exist(grid, word):",
          "    for each cell [row, col] in grid:",
          "        if walk(grid, word, row, col, 0):",
          "            return true",
          "    return false"
        ],
        "highlight": [
          14
        ]
      },
      "explain": "Any tile can hold the first letter. walk marks, explores and unmarks on its own.",
