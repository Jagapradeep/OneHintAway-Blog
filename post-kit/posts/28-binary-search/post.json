    {
      "type": "template",
      "teaser": "Binary search in 12 lines",
      "title": "Binary search",
      "code": {
        "lines": [
          "function search(nums, target):",
          "    low = 0",
          "    high = length(nums) - 1",
          "    while low <= high:",
          "        middle = floor((low + high) / 2)",
          "        if nums[middle] == target:",
          "            return middle",
          "        else if nums[middle] < target:",
          "            low = middle + 1",
          "        else:",
          "            high = middle - 1",
          "    return -1"
        ],
        "highlight": [
          8
        ]
      },
      "example": {
        "call": "search([1, 3, 5, 7, 9, 11], 7)",
        "expr": "FOUND",
        "show": "{{FOUND}}"
      }
    },
    {
      "type": "trap",
      "teaser": "The bug that misses the 11",
      "title": "Keep low <= high",
      "lead": "With low < high the loop stops when one value is left, without checking it.",
