    {
      "type": "solution",
      "teaser": "Part 1: edges and range",
      "title": "Edges and range",
      "code": {
        "lines": [
          "function edge(nums, k, empty):",
          "    if k < 0 or k >= length(nums):",
          "        return empty",
          "    return nums[k]",
          "function median(a, b):",
          "    if length(a) > length(b):",
          "        return median(b, a)   // a: shorter",
          "    m = length(a)",
          "    n = length(b)",
          "    half = floor((m + n + 1) / 2)",
          "    low = 0",
          "    high = m",
          "    while low < high:",
          "        i = floor((low + high) / 2)"
        ]
      }
    },
    {
      "type": "solution",
      "teaser": "Part 2: cut, then read",
      "title": "Cut, then read",
      "code": {
        "lines": [
          "        if b[half - i - 1] > a[i]:",
          "            low = i + 1   // more from a",
          "        else:",
          "            high = i",
          "    j = half - low   // low = the cut in a",
          "    leftA = edge(a, low - 1, -infinity)",
          "    leftB = edge(b, j - 1, -infinity)",
          "    leftMax = max(leftA, leftB)",
          "    if (m + n) mod 2 == 1:",
          "        return leftMax",
          "    rightA = edge(a, low, infinity)",
          "    rightB = edge(b, j, infinity)",
          "    rightMin = min(rightA, rightB)",
          "    return (leftMax + rightMin) / 2"
        ],
        "highlight": [
          15
        ]
      }
