# Copy to deploy/compose/.env (git-ignored) and fill in the blanks. Never commit real values.
# Docker Compose reads the .env beside docker-compose.yml by itself.
# A good random value:  openssl rand -hex 32

# --- PostgreSQL ---
POSTGRES_DB=onehintaway
POSTGRES_USER=onehintaway
POSTGRES_PASSWORD=

# --- API ---
# Mixed into visitor hashes. The API won't start without it.
VISITOR_SALT=
# Shared secret for the posts sync (PUT /api/v1/admin/posts). Blank = sync switched off.
ADMIN_TOKEN=
# Site addresses allowed to call the API from a browser, comma-separated.
CORS_ORIGINS=http://localhost:3000
# The API's own public address, used in confirmation links.
PUBLIC_URL=http://localhost:8080

# The site's address: a reader who opens a confirmation link is sent to /subscribed/ there.
SITE_URL=http://localhost:3000
# Resend API key. Blank = confirmation links are written to the log, no email is sent.
RESEND_API_KEY=
MAIL_FROM=One Hint Away <hello@onehintaway.com>
# Port on this machine (127.0.0.1 only).
API_PORT=8080

# --- Umami ---
# Password of Umami's own database user. It goes inside a URL, so letters and digits
# only (hex is fine). Read once, when the database volume is first created.
UMAMI_DB_PASSWORD=
# Signs Umami's login sessions.
UMAMI_APP_SECRET=
# Port on this machine (127.0.0.1 only). 3000 is taken by `npm run dev`.
UMAMI_PORT=3001
