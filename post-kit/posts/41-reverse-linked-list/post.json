    {
      "type": "template",
      "teaser": "Reverse a list in 9 lines",
      "title": "Reverse a list",
      "code": {
        "lines": [
          "function reverseList(head):",
          "    prev = none",
          "    curr = head",
          "    while curr != none:",
          "        rest = curr.next   // save it",
          "        curr.next = prev   // turn the arrow",
          "        prev = curr",
          "        curr = rest",
          "    return prev"
        ],
        "highlight": [
          5
        ]
      },
      "explain": "Line 5 saves the rest before line 6 turns the arrow. prev ends on the old last node: the new head.",
      "example": {
        "call": "reverseList(1 → 2 → 3 → 4 → 5)",
        "expr": "sp(REVERSED)",
        "show": "{{sp(REVERSED)}}"
      }
    },
    {
      "type": "trap",
      "teaser": "The list that loses 4 nodes",
      "title": "Save the rest first",
      "lead": "Skip line 5 and move with curr = curr.next. After line 6, that next is prev: the walk turns back.",
      "trap": {
        "call": "reverseList(1 → 2 → 3 → 4 → 5)",
        "wrong": {
          "code": [
            "curr.next = prev",
            "curr = curr.next"
          ],
          "note": "curr becomes none after node 1.",
          "result": "{{sp(WRONG)}}"
        },
        "right": {
          "code": [
            "rest = curr.next",
            "curr = rest"
          ],
          "note": "The rest is held safely.",
          "result": "{{sp(REVERSED)}}"
        }
      },
