    {
      "type": "extra",
      "label": "PERMUTATIONS",
      "board": "Permutations",
      "teaser": "The moves as permutations",
      "title": "Every order",
      "blocks": [
        {
          "type": "code",
          "lines": [
            "function permute(nums, used, path, out):",
            "    if length(path) == length(nums):",
            "        add a copy of path to out",
            "        return out",
            "    for i from 0 to length(nums) - 1:",
            "        if not used[i]:",
            "            used[i] = true   // choose",
            "            add nums[i] to path",
            "            permute(nums, used, path, out)",
            "            remove last from path   // undo",
            "            used[i] = false",
            "    return out"
          ],
          "highlight": [
            9
          ]
        },
        {
          "type": "text",
          "style": "muted",
          "text": "Start with used all false and path and out empty."
        }
      ]
    },
    {
      "type": "template",
      "teaser": "Same moves, a new rule",
      "title": "Combination sum",
      "code": {
        "start": 13,
        "lines": [
          "function find(nums, i, left, path, out):",
          "    if left == 0:",
          "        add a copy of path to out",
          "        return out",
          "    for j from i to length(nums) - 1:",
          "        if nums[j] <= left:",
          "            add nums[j] to path   // choose",
          "            rest = left - nums[j]",
          "            find(nums, j, rest, path, out)",
          "            remove last from path   // undo",
          "    return out"
        ],
        "highlight": [
          21
        ]
      },
      "explain": "Pick numbers that add up to the target, reusing any. Line 21 passes j: the same number again, never an earlier one.",
      "example": {
        "call": "find([2, 3, 6, 7], 0, 7, [], [])",
        "expr": "show(COMBOS)",
        "show": "{{show(COMBOS)}}"
      }
    },
    {
      "type": "trap",
      "teaser": "The reorder bug",
      "title": "Don't go back to 0",
      "lead": "Pass 0 instead of j on line 21 and every order of the same numbers is found again.",
      "trap": {
        "call": "find([2, 3, 6, 7], 0, 7, [], [])",
        "wrong": {
          "code": [
            "find(…, 0, rest, …)"
          ],
          "note": "2 2 3 comes out three times.",
          "result": "{{show(wrong_combos(CANDS, TARGET))}}"
        },
        "right": {
          "code": [
            "find(…, j, rest, …)"
          ],
          "note": "Never an earlier number.",
          "result": "{{show(COMBOS)}}"
        }
      },
