    {
      "type": "template",
      "teaser": "Lower bound in 10 lines",
      "title": "Lower bound",
      "code": {
        "lines": [
          "function lowerBound(nums, target):",
          "    low = 0",
          "    high = length(nums)   // one past the end",
          "    while low < high:",
          "        middle = floor((low + high) / 2)",
          "        if nums[middle] < target:",
          "            low = middle + 1",
          "        else:",
          "            high = middle   // may be it",
          "    return low"
        ],
        "highlight": [
          9
        ]
      },
      "example": {
        "call": "lowerBound([1, 2, 2, 2, 4, 5], 2)",
        "expr": "LOWER",
        "show": "{{LOWER}}"
      }
    },
    {
      "type": "trap",
      "teaser": "The search that finds the wrong 2",
      "title": "Any match isn't first",
      "lead": "Post 28's search returns as soon as it sees a 2. That's a 2, not the first 2.",
      "trap": {
        "call": "first 2 in [1, 2, 2, 2, 4, 5]",
        "wrong": {
          "code": [
            "if nums[middle] == target:",
            "    return middle"
          ],
          "note": "It stops at the middle 2.",
          "result": "{{first_match_search(EXAMPLE, 2)}}"
        },
        "right": {
          "code": [
            "else:",
            "    high = middle"
          ],
          "note": "It keeps going left.",
          "result": "{{LOWER}}"
        }
      },
