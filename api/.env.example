# Copy to api/.env (git-ignored) and fill in. Never commit real values.
# Read by both `docker compose` and the API (application.properties imports it).

POSTGRES_DB=onehintaway
POSTGRES_USER=onehintaway
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

# Mixed into visitor hashes. Any long random string; the API won't start without it.
VISITOR_SALT=

# Shared secret for the posts sync (PUT /api/v1/admin/posts). Blank = sync switched off.
ADMIN_TOKEN=

# Site addresses allowed to call the API from a browser, comma-separated.
CORS_ORIGINS=http://localhost:3000

# The API's own public address, used in confirmation links.
PUBLIC_URL=http://localhost:8080

# The site's address: confirmation links land on /subscribed/ there, sign-in links open /sign-in/ there.
SITE_URL=http://localhost:3000

# Resend API key. Blank = confirmation links are written to the log, no email is sent.
RESEND_API_KEY=
# Must be an address on a domain verified in Resend.
MAIL_FROM=One Hint Away <hello@onehintaway.com>
# Accounts. The session cookie is marked Secure (HTTPS only). Chrome, Edge and Firefox still
# accept it from http://localhost; set false only if your browser does not (Safari).
SESSION_COOKIE_SECURE=true
# Sign-in links per hour: per caller address, and per email address.
LINK_PER_HOUR=10
LINK_PER_EMAIL_PER_HOUR=3
