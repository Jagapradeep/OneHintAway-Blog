      "type": "extra",
      "label": "THE MOVE",
      "board": "Answer + partition",
      "teaser": "The answer, then partition",
      "title": "Partition",
      "blocks": [
        {
          "type": "code",
          "lines": [
            "function partition(nums, low, high):",
            "    pivot = nums[high]",
            "    wall = low   // next small slot",
            "    for j from low to high - 1:",
            "        if nums[j] < pivot:",
            "            swap nums[wall], nums[j]",
            "            wall = wall + 1",
            "    swap nums[wall], nums[high]   // home",
            "    return wall"
          ],
          "highlight": [
            5
          ]
        },
        {
          "type": "text",
          "text": "Everything left of wall is smaller than the pivot. Line 8 drops the pivot right after them."
        },
        {
          "type": "text",
          "text": "partition([5, 2, 4, 1, 3], 0, 4) returns **{{spot_of(EXAMPLE)}}**."
        }
      ]
    },
