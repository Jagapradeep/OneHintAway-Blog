      "type": "template",
      "teaser": "Selection sort in 9 lines",
      "title": "Selection sort",
      "code": {
        "lines": [
          "function selectionSort(nums):",
          "    n = length(nums)",
          "    for i from 0 to n - 2:",
          "        smallest = i   // an index",
          "        for j from i + 1 to n - 1:",
          "            if nums[j] < nums[smallest]:",
          "                smallest = j",
          "        swap nums[i], nums[smallest]",
          "    return nums"
        ],
        "highlight": [
          6
        ]
      },
      "explain": "Lines 5 to 7 find the smallest. Line 8 swaps it into slot i.",
      "example": {
        "call": "selectionSort([5, 2, 4, 1, 3])",
        "expr": "selection_sort([5, 2, 4, 1, 3])"
      }
    },
    {
      "type": "trap",
      "teaser": "The bug that gives {{sp(wrong_sort(EXAMPLE))}}",
      "title": "Keep the index",
      "lead": "Keep the smallest value, not its index, and the old nums[i] is lost.",
      "trap": {
        "call": "selectionSort([5, 2, 4, 1, 3])",
        "wrong": {
          "code": [
            "smallest = nums[j]",
            "nums[i] = smallest"
          ],
          "note": "The 5 is lost; 1 gets copied.",
          "result": "{{sp(wrong_sort(EXAMPLE))}}"
        },
        "right": {
          "code": [
            "smallest = j",
            "swap nums[i], nums[smallest]"
          ],
          "note": "The swap keeps every value.",
          "result": "{{sp(selection_sort(EXAMPLE))}}"
        }
      },
