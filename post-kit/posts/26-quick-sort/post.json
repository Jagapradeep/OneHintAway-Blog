    {
      "type": "template",
      "teaser": "Quickselect: keep one side",
      "title": "Keep only one side",
      "code": {
        "lines": [
          "// use 2: only the k-th smallest",
          "function quickSelect(nums, k):",
          "    low = 0",
          "    high = length(nums) - 1",
          "    while true:",
          "        spot = partition(nums, low, high)",
          "        if spot == k - 1:",
          "            return nums[spot]",
          "        if spot < k - 1:",
          "            low = spot + 1",
          "        else:",
          "            high = spot - 1"
        ],
        "highlight": [
          24
        ],
        "start": 16
      },
