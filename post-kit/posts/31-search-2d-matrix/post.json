    {
      "type": "extra",
      "label": "THE LOOKUP",
      "board": "Answer + the lookup",
      "teaser": "The answer, then the lookup",
      "title": "Index to cell",
      "blocks": [
        {
          "type": "code",
          "lines": [
            "function cell(grid, i):",
            "    cols = length(grid[0])",
            "    row = floor(i / cols)",
            "    col = i mod cols",
            "    return grid[row][col]"
          ]
        },
        {
          "type": "text",
          "text": "Divide by the number of [[columns]], not rows: each row holds cols values."
        }
      ]
    },
    {
      "type": "template",
      "teaser": "The search in 13 lines",
      "title": "Search a sorted grid",
      "code": {
        "lines": [
          "function searchMatrix(grid, target):",
          "    cells = length(grid) * length(grid[0])",
          "    low = 0",
          "    high = cells - 1",
          "    while low <= high:",
          "        middle = floor((low + high) / 2)",
          "        if cell(grid, middle) == target:",
          "            return true",
          "        else if cell(grid, middle) < target:",
          "            low = middle + 1",
          "        else:",
          "            high = middle - 1",
          "    return false"
        ],
        "highlight": [
          7
        ]
      },
      "example": {
        "call": "searchMatrix([[1, 3, 5], [7, 9, 11]], 11)",
        "expr": "FOUND",
        "show": "{{FOUND}}"
      }
    },
    {
      "type": "trap",
      "teaser": "The mix-up that loses the 7",
      "title": "Rows, not columns",
      "lead": "Swap the two lines in cell and the grid is read column by column: 1 7 3 9 5 11. That isn't sorted.",
      "trap": {
        "call": "searchMatrix([[1, 3, 5], [7, 9, 11]], 7)",
        "wrong": {
          "code": [
            "row = i mod rows",
            "col = floor(i / rows)"
          ],
          "note": "Binary search on an unsorted row misses 7.",
          "result": "{{tf(wrong_search(GRID, 7))}}"
        },
        "right": {
          "code": [
            "row = floor(i / cols)",
            "col = i mod cols"
          ],
          "note": "Row after row, so it stays sorted.",
          "result": "{{tf(search_matrix(GRID, 7))}}"
        }
      },
