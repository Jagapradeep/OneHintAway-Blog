    {
      "type": "template",
      "teaser": "Fast power in 9 lines",
      "title": "Fast power",
      "code": {
        "lines": [
          "function power(x, n, m):",
          "    answer = 1 mod m",
          "    block = x mod m",
          "    while n > 0:",
          "        if n mod 2 == 1:",
          "            answer = (answer * block) mod m",
          "        block = (block * block) mod m",
          "        n = floor(n / 2)",
          "    return answer"
        ],
        "highlight": [
          5
        ]
      },
      "explain": "Line 5 uses the block when n is odd. Lines 7 and 8 square the block and halve n.",
      "example": {
        "call": "power(3, 13, 1000)",
        "expr": "ANSWER",
        "show": "{{ANSWER}}"
      }
    },
    {
      "type": "trap",
