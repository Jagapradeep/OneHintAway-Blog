   "type": "template",
   "teaser": "Prefix sums in 9 lines",
   "title": "Prefix sum",
   "code": {
    "lines": [
     "function buildPrefix(nums):",
     "    n = length(nums)",
     "    prefix = array of n + 1 zeros",
     "    for i from 0 to n - 1:",
     "        prefix[i + 1] = prefix[i] + nums[i]",
     "    return prefix",
     "",
     "function rangeSum(prefix, left, right):",
     "    return prefix[right + 1] - prefix[left]"
    ],
    "highlight": [
     9
    ]
   },
   "explain": "Build once (lines 1 to 6). Then every question is line 9: one subtraction.",
   "example": {
    "call": "rangeSum(buildPrefix([3, 1, 4, 1, 5]), 1, 3)",
    "expr": "Q1",
    "show": "{{Q1}}"
   }
  },
  {
   "type": "trap",
   "teaser": "The bug that returns {{WRONG}}",
   "title": "Mind the shift",
   "lead": "prefix[right] stops one short: it drops nums[right].",
   "trap": {
    "call": "rangeSum(prefix, 1, 3)",
    "wrong": {
     "code": [
      "prefix[right]",
      "  - prefix[left]"
     ],
     "note": "8 − 3 drops the last 1.",
     "result": "{{WRONG}}"
    },
