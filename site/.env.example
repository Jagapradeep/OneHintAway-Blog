# Settings for running the site on your own machine. Copy this file to .env.local
# (git-ignored); `npm run dev` and `npm run build` read it every time they start.
# Nothing here is a secret: NEXT_PUBLIC_ values are built into the pages readers download.
# Production does not use this file: the same names are set in Cloudflare Workers Builds.

# Your local API (api/, `./mvnw spring-boot:run`). Leave it out and the site builds with
# no API at all: no view counts, no search, no accounts. Posts still work.
NEXT_PUBLIC_API_URL=http://localhost:8080

# Sign in, "Mark as done" and the account menu. Needs NEXT_PUBLIC_API_URL as well.
NEXT_PUBLIC_ACCOUNTS=on

# Cloudflare Turnstile on the sign-in form. Leave it out locally (your API has no secret).
# To try it: Cloudflare's test key 1x00000000000000000000AA always passes, and the API needs
# TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA in api/.env.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# The footer's newsletter form is on unless this says off.
# NEXT_PUBLIC_SIGNUP=off

# Umami analytics. Leave these out locally, or your test visits count as readers.
# NEXT_PUBLIC_UMAMI_URL=
# NEXT_PUBLIC_UMAMI_WEBSITE_ID=
